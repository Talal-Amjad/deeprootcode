# ---------------------------------------------------------------
# Deep Root Code — environment configuration
# Copy this file to .env.local for local development and add the
# same variables in your hosting provider (e.g. Vercel → Settings
# → Environment Variables) for production.
# ---------------------------------------------------------------

# Public site URL, used for canonical URLs, sitemap, Open Graph and
# structured data. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact email shown on the website (footer, contact page).
# Leave empty until a real inbox exists — the site then hides it.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------
# Contact form delivery (server-only — never prefix with NEXT_PUBLIC_)
# Configure ONE of the options below. Without either, submissions
# are logged to the server console in development and rejected
# with a clear message in production.
# ---------------------------------------------------------------

# Option A — Resend (https://resend.com)
RESEND_API_KEY=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Deep Root Code <website@yourdomain.com>".
CONTACT_FROM_EMAIL=

# Option B — any HTTPS webhook (Zapier, Make, n8n, Slack workflow, your own API).
# Receives a JSON POST with the validated submission.
CONTACT_WEBHOOK_URL=

# ---------------------------------------------------------------
# Search engine verification (optional, public meta tags)
# Google Search Console → "HTML tag" method → copy only the content value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → "Meta tag" method → copy only the content value.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
